# =====================================================================
# Plataforma web institucional - Colegio Técnico Humanístico Nueva Canaán
# Copiar este archivo como ".env" y completar los valores.
# NUNCA subir el archivo ".env" al repositorio.
# =====================================================================

# Clave secreta de Flask (sesiones y CSRF).
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Entorno: development | production | testing
FLASK_ENV=development

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
# Desarrollo (por defecto): SQLite en ./instance/nueva_canaan.db
#
# PRODUCCIÓN (Render + Supabase): copie la cadena de conexión desde
#   Supabase → Project Settings → Database → Connection string → "Session pooler"
#   y péguela en DATABASE_URL. El código la normaliza automáticamente
#   (añade el driver psycopg y sslmode=require).
#
#   DATABASE_URL=postgresql://postgres.<ref>:<CLAVE>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# (La conexión directa db.<ref>.supabase.co también funciona, pero puede fallar en
#  Render porque es sólo IPv6. El "Transaction pooler" del puerto 6543 funciona
#  igual: el código desactiva las sentencias preparadas que ese modo no admite.)
#
# DATABASE_SSLMODE=require
# DB_POOL_SIZE=4
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=280
# DATABASE_URL=

# ---------------------------------------------------------------------
# Cookies / sesión
# ---------------------------------------------------------------------
# En producción con HTTPS debe ser "true" (Render sirve HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8

# ---------------------------------------------------------------------
# Subidas de archivos
# ---------------------------------------------------------------------
MAX_UPLOAD_MB=8
MAX_ATTACHMENT_MB=5
# UPLOAD_FOLDER=/var/data/uploads

# ---------------------------------------------------------------------
# Seguridad de acceso
# ---------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=8
ITEMS_PER_PAGE=10

# ---------------------------------------------------------------------
# Identidad institucional (rutas relativas a app/static/)
# ---------------------------------------------------------------------
INSTITUTION_LOGO=img/logo.svg
INSTITUTION_COVER=img/portada.svg
INSTITUTION_FAVICON=img/logo.svg

# ---------------------------------------------------------------------
# Cuenta inicial de administración (sólo para el primer arranque;
# cámbiela inmediatamente después de iniciar sesión)
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@nuevacanaan.edu
ADMIN_PASSWORD=CambiarEstaClave123
ADMIN_NAME=Administrador del sistema
