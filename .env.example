# =====================================================================
# Muro institucional Nueva Canaán
# Copiar este archivo como ".env" y completar los valores.
# NUNCA subir el archivo ".env" al repositorio.
# =====================================================================

# Clave secreta de Flask (sesiones y CSRF).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# development | production | testing
FLASK_ENV=development

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
# Por defecto se usa SQLite en ./instance/nueva_canaan.db.
#
# En producción se puede conservar la base de datos en Supabase definiendo
# DATABASE_URL con la cadena de conexión PostgreSQL. También se puede usar
# SQLite en un disco persistente de Render:
#   DATABASE_URL=sqlite:////var/data/nueva_canaan.db
#
# DATABASE_URL=
# DATABASE_SSLMODE=require
# DB_POOL_SIZE=4
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=280

# ---------------------------------------------------------------------
# Cookies / sesión
# ---------------------------------------------------------------------
# En producción con HTTPS debe ser "true" (Render sirve HTTPS).
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8

# ---------------------------------------------------------------------
# Fotografías
# ---------------------------------------------------------------------
# Tamaño máximo del envío completo (varias fotos incluidas).
MAX_UPLOAD_MB=8
# Tamaño máximo de cada fotografía.
MAX_ATTACHMENT_MB=5
# Carpeta de fotografías. En Render con disco persistente: /var/data/uploads
# UPLOAD_FOLDER=/var/data/uploads

# ---------------------------------------------------------------------
# Identidad institucional (rutas relativas a app/static/)
# ---------------------------------------------------------------------
INSTITUTION_LOGO=img/logo.svg
INSTITUTION_FAVICON=img/logo.svg

# Hora local para mostrar las publicaciones (Bolivia = -4).
UTC_OFFSET_HOURS=-4

# ---------------------------------------------------------------------
# Cuenta administradora inicial
# Se crea al ejecutar: python -m app.cli init-and-seed
# La contraseña se guarda cifrada (hash) en la base de datos.
# ---------------------------------------------------------------------
ADMIN_EMAIL=admin@nuevacanaan.edu
ADMIN_PASSWORD=CambiarEstaClave123
ADMIN_NAME=Administrador
